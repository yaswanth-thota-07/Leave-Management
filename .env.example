PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.lokcdse.mongodb.net
DATABASE_NAME=sehatsure

# Optional — enables the staff-only AI document/recommendation review
# (see utils/docForensics.js, utils/aiRecommendation.js). Without this key
# the feature still works: it falls back to the built-in offline heuristic
# and rule-based score, with no network calls and no cost.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
